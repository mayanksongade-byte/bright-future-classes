rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if requesting user is an active admin
    function isActiveAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    // Helper function: Check if requesting user is an assigned teacher for the class
    function isAssignedTeacher(classId) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher"
        && (
          exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
          && classId in get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('classIds', [])
        );
    }

    // Helper function: Check if requesting user is the student owner
    function isStudentOwner(studentId) {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "student"
        && (
          request.auth.uid == studentId
          || (exists(/databases/$(database)/documents/students/$(studentId)) && get(/databases/$(database)/documents/students/$(studentId)).data.get('userId', '') == request.auth.uid)
        );
    }

    // Users Collection: Authenticated user can read only their own user document; writes blocked
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Students Collection: Authenticated users can read; Active Admin can create, read, update, delete
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isActiveAdmin();
    }

    // Classes Collection: Authenticated users can read; Active Admin can create, read, update, delete
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isActiveAdmin();
    }

    // Teachers Collection: Authenticated users can read; Active Admin can create, read, update, delete
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isActiveAdmin();
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read, create, update, delete: if request.auth != null && (
        isActiveAdmin()
        || (isStudentOwner(resource != null ? resource.data.studentId : request.resource.data.studentId))
        || isAssignedTeacher(resource != null ? resource.data.classId : request.resource.data.classId)
      );
    }

    // Fees Collections: Active Admin can manage fees and payments
    match /fees/{feeId} {
      allow read, create, update, delete: if isActiveAdmin();
    }
    match /fee_payments/{paymentId} {
      allow read, create, update, delete: if isActiveAdmin();
    }

    // Homework Collection: Active Admin can manage homework
    match /homework/{homeworkId} {
      allow read, create, update, delete: if isActiveAdmin();
    }

    // Tests & Marks Collections: Active Admin can manage tests and marks
    match /tests/{testId} {
      allow read, create, update, delete: if isActiveAdmin();
    }
    match /marks/{markId} {
      allow read, create, update, delete: if isActiveAdmin();
    }

    // Notices Collection: Active Admin can manage notices
    match /notices/{noticeId} {
      allow read, write: if isActiveAdmin();
    }

    // Complaints Collection: Active Admin can manage complaints
    match /complaints/{complaintId} {
      allow read, write: if isActiveAdmin();
    }

    // Settings Collection: Active Admin can read/write global institute settings
    match /settings/app {
      allow read, write: if isActiveAdmin();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
