rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if requesting user is an active admin (robust against casing/missing isActive)
    function isActiveAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "admin"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "Admin"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "ADMIN"
        )
        && (
          !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['isActive'])
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true
        );
    }

    // Helper function: Check if requesting user is an assigned teacher for the class
    function isAssignedTeacher(classId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "teacher"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "Teacher"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "TEACHER"
        )
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teacherId', '') != ""
        && classId in get(/databases/$(database)/documents/teachers/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teacherId', ''))).data.get('classIds', []);
    }

    // Helper function: Check if requesting user is the student owner
    function isStudentOwner(studentId) {
      return request.auth != null
        && (
          request.auth.uid == studentId
          || (exists(/databases/$(database)/documents/students/$(studentId)) && get(/databases/$(database)/documents/students/$(studentId)).data.get('userId', '') == request.auth.uid)
        );
    }

    // Login IDs Collection: Allow exact document 'get' for authentication lookup; NO listing; Active Admin can manage
    match /login_ids/{userId} {
      allow get: if true;
      allow list: if false;

      allow create, update: if isActiveAdmin();
      allow delete: if isActiveAdmin();
    }

    // Users Collection: Authenticated user can read own document or active admin can read/write
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isActiveAdmin());
      allow create, update: if isActiveAdmin();
      allow delete: if isActiveAdmin();
    }

    // Students Collection: Authenticated users can read if assigned teacher or admin
    match /students/{studentId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && isAssignedTeacher(resource.data.classId))
        || (request.resource != null && isAssignedTeacher(request.resource.data.classId))
        || isStudentOwner(studentId)
      );
      allow create, update, delete: if isActiveAdmin();
    }

    // Classes Collection: Authenticated users can read if assigned teacher or admin
    match /classes/{classId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || isAssignedTeacher(classId)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "student"
      );
      allow create, update, delete: if isActiveAdmin();
    }

    // Teachers Collection: Authenticated user can read own teacher profile or admin can manage
    match /teachers/{teacherId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teacherId', '') == teacherId)
      );
      allow create, update, delete: if isActiveAdmin();
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && isStudentOwner(resource.data.studentId))
        || (resource != null && isAssignedTeacher(resource.data.classId))
      );
      allow create: if request.auth != null && (
        isActiveAdmin()
        || (isAssignedTeacher(request.resource.data.classId) && !exists(/databases/$(database)/documents/attendance/$(attendanceId)))
      );
      allow update, delete: if isActiveAdmin();
    }

    // Attendance Sessions Collection
    match /attendance_sessions/{sessionId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && isAssignedTeacher(resource.data.classId))
      );
      allow create: if request.auth != null && (
        isActiveAdmin()
        || (isAssignedTeacher(request.resource.data.classId) && !exists(/databases/$(database)/documents/attendance_sessions/$(sessionId)))
      );
      allow update, delete: if isActiveAdmin();
    }

    // Attendance Audit Collection
    match /attendance_audit/{auditId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && isAssignedTeacher(resource.data.classId))
      );
      allow create: if request.auth != null && (
        isActiveAdmin()
      );
      allow update, delete: if isActiveAdmin();
    }

    // Fees Collections: Active Admin can manage fees and payments
    match /fees/{feeId} {
      allow read, create, update, delete: if isActiveAdmin();
    }
    match /fee_payments/{paymentId} {
      allow read, create, update, delete: if isActiveAdmin();
    }

    // Homework Collection: Active Admin can manage homework
    match /homework/{homeworkId} {
      allow read, create, update, delete: if isActiveAdmin();
    }

    // Tests & Marks Collections: Active Admin can manage tests/marks; Assigned teachers can read/create/update
    match /tests/{testId} {
      allow read, create, update: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && isAssignedTeacher(request.resource.data.classId))
        || (request.resource != null && isAssignedTeacher(request.resource.data.classId))
      );
      allow delete: if isActiveAdmin();
    }
    match /marks/{markId} {
      allow read, create, update: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && isAssignedTeacher(request.resource.data.classId))
        || (request.resource != null && isAssignedTeacher(request.resource.data.classId))
        || (resource != null && isStudentOwner(resource.data.studentId))
        || (request.resource != null && isStudentOwner(request.resource.data.studentId))
      );
      allow delete: if isActiveAdmin();
    }

    // Notices Collection: Active Admin can manage notices
    match /notices/{noticeId} {
      allow read, write: if isActiveAdmin();
    }

    // Complaints Collection: Active Admin can manage complaints; Assigned teachers and student owners can read/create/update
    match /complaints/{complaintId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && isAssignedTeacher(resource.data.classId))
        || (resource != null && isStudentOwner(resource.data.studentId))
      );
      allow create, update: if request.auth != null && (
        isActiveAdmin()
        || (request.resource != null && isAssignedTeacher(request.resource.data.classId))
        || (request.resource != null && isStudentOwner(request.resource.data.studentId))
      );
      allow delete: if isActiveAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || resource.data.recipientId == request.auth.uid
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "admin" && resource.data.get('recipientRole', '') == "admin")
      );
      allow create: if request.auth != null && (
        isActiveAdmin()
        || request.resource.data.recipientId == request.auth.uid
        || request.resource.data.get('recipientRole', '') == "admin"
      );
      allow update: if request.auth != null && (
        isActiveAdmin()
        || (
          resource.data.recipientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt'])
        )
      );
      allow delete: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && resource.data.recipientId == request.auth.uid)
      );
    }

    // Settings Collection: Active Admin can read/write global institute settings
    match /settings/app {
      allow read, write: if isActiveAdmin();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
