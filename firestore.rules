rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if requesting user is an active admin (robust against casing/missing isActive)
    function isActiveAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ["admin", "Admin", "ADMIN"]
        )
        && (
          !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['isActive'])
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true
        );
    }

    // Helper function: Check if requesting user is an active teacher
    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ["teacher", "Teacher", "TEACHER"]
        )
        && (
          !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['isActive'])
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true
        );
    }

    // Helper function: Check if requesting user is an assigned teacher for the class
    function isAssignedTeacher(classId) {
      return isTeacher()
        && classId != null
        && classId != ""
        && (
          (
            exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
            && classId in get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('classIds', [])
          )
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teacherId', '') != ""
            && exists(/databases/$(database)/documents/teachers/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teacherId', '')))
            && classId in get(/databases/$(database)/documents/teachers/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teacherId', ''))).data.get('classIds', [])
          )
        );
    }

    // Helper function: Check if requesting user is an assigned teacher for the class and subject
    function isAssignedTeacherForSubject(classId, subject) {
      return isTeacher()
        && classId != null
        && classId != ""
        && subject != null
        && subject != ""
        && (
          (
            exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
            && classId in get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('classIds', [])
            && (
              subject in get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('subjects', [])
              || subject == get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('subject', '')
            )
          )
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teacherId', '') != ""
            && exists(/databases/$(database)/documents/teachers/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teacherId', '')))
            && classId in get(/databases/$(database)/documents/teachers/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teacherId', ''))).data.get('classIds', [])
            && (
              subject in get(/databases/$(database)/documents/teachers/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teacherId', ''))).data.get('subjects', [])
              || subject == get(/databases/$(database)/documents/teachers/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teacherId', ''))).data.get('subject', '')
            )
          )
        );
    }

    // Helper function: Check if teacher is authorized for a test reference ID or test deletion metadata
    function isTeacherAuthorizedForTestRef(refId) {
      return request.auth != null
        && (
          (
            refId != null
            && refId != ''
            && exists(/databases/$(database)/documents/tests/$(refId))
            && isAssignedTeacherForSubject(
                 get(/databases/$(database)/documents/tests/$(refId)).data.get('classId', ''),
                 get(/databases/$(database)/documents/tests/$(refId)).data.get('subject', '')
               )
          )
          || (
            request.resource.data.get('type', '') == 'test_deleted'
            && request.resource.data.get('metadata', {}).get('classId', '') != ''
            && request.resource.data.get('metadata', {}).get('subject', '') != ''
            && isAssignedTeacherForSubject(
                 request.resource.data.metadata.get('classId', ''),
                 request.resource.data.metadata.get('subject', '')
               )
          )
        );
    }

    // Helper function: Check if requesting user is the student owner
    function isStudentOwner(studentId) {
      return request.auth != null
        && studentId != null
        && studentId != ""
        && (
          request.auth.uid == studentId
          || (exists(/databases/$(database)/documents/students/$(studentId)) && get(/databases/$(database)/documents/students/$(studentId)).data.get('userId', '') == request.auth.uid)
        );
    }

    // Login IDs Collection: Allow exact document 'get' for authentication lookup; NO listing; Active Admin can manage
    match /login_ids/{userId} {
      allow get: if true;
      allow list: if false;

      allow create, update: if isActiveAdmin();
      allow delete: if isActiveAdmin();
    }

    // Users Collection: Authenticated user can read own document or active admin can read/write
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isActiveAdmin());
      allow create, update: if isActiveAdmin();
      allow delete: if isActiveAdmin();
    }

    // Students Collection: Authenticated users can read if assigned teacher, student owner, or admin
    match /students/{studentId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && resource.data.get('classId', '') != '' && isAssignedTeacher(resource.data.classId))
        || isStudentOwner(studentId)
      );
      allow create, update, delete: if isActiveAdmin();
    }

    // Classes Collection: Authenticated users can read if assigned teacher or admin
    match /classes/{classId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || isAssignedTeacher(classId)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "student"
      );
      allow create, update, delete: if isActiveAdmin();
    }

    // Teachers Collection: Authenticated user can read own teacher profile or admin can manage
    match /teachers/{teacherId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teacherId', '') == teacherId)
        || (request.auth.uid == teacherId)
      );
      allow create, update, delete: if isActiveAdmin();
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && isStudentOwner(resource.data.get('studentId', '')))
        || (resource != null && resource.data.get('classId', '') != '' && isAssignedTeacher(resource.data.classId))
      );
      allow create: if request.auth != null && (
        isActiveAdmin()
        || (
          request.resource.data.get('classId', '') != ''
          && isAssignedTeacher(request.resource.data.classId)
          && !exists(/databases/$(database)/documents/attendance/$(attendanceId))
        )
      );
      allow update, delete: if isActiveAdmin();
    }

    // Attendance Sessions Collection
    match /attendance_sessions/{sessionId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && resource.data.get('classId', '') != '' && isAssignedTeacher(resource.data.classId))
      );
      allow create: if request.auth != null && (
        isActiveAdmin()
        || (
          request.resource.data.get('classId', '') != ''
          && isAssignedTeacher(request.resource.data.classId)
          && !exists(/databases/$(database)/documents/attendance_sessions/$(sessionId))
        )
      );
      allow update, delete: if isActiveAdmin();
    }

    // Attendance Audit Collection
    match /attendance_audit/{auditId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && resource.data.get('classId', '') != '' && isAssignedTeacher(resource.data.classId))
      );
      allow create: if request.auth != null && (
        isActiveAdmin()
      );
      allow update, delete: if isActiveAdmin();
    }

    // Holidays Collection: Authenticated users can read holidays; Active Admin can create/update/delete
    match /holidays/{holidayId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isActiveAdmin();
    }

    // Fees Collections: Active Admin can manage fees and payments
    match /fees/{feeId} {
      allow read, create, update, delete: if isActiveAdmin();
    }
    match /fee_payments/{paymentId} {
      allow read, create, update, delete: if isActiveAdmin();
    }

    // Homework Collection: Active Admin can manage homework
    match /homework/{homeworkId} {
      allow read, create, update, delete: if isActiveAdmin();
    }

    // Tests & Marks Collections: Active Admin can manage tests/marks; Assigned teachers can read/create/update/delete
    match /tests/{testId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && resource.data.get('classId', '') != '' && isAssignedTeacher(resource.data.classId))
      );
      allow create: if request.auth != null && (
        isActiveAdmin()
        || (
          request.resource != null
          && request.resource.data.get('classId', '') != ''
          && request.resource.data.get('subject', '') != ''
          && isAssignedTeacherForSubject(request.resource.data.classId, request.resource.data.subject)
        )
      );
      allow update: if request.auth != null && (
        isActiveAdmin()
        || (
          resource != null
          && resource.data.get('classId', '') != ''
          && resource.data.get('subject', '') != ''
          && isAssignedTeacherForSubject(resource.data.classId, resource.data.subject)
          && request.resource.data.get('classId', '') == resource.data.classId
          && request.resource.data.get('subject', '') == resource.data.subject
        )
      );
      allow delete: if request.auth != null && (
        isActiveAdmin()
        || (
          resource != null
          && resource.data.get('classId', '') != ''
          && resource.data.get('subject', '') != ''
          && isAssignedTeacherForSubject(resource.data.classId, resource.data.subject)
        )
      );
    }

    match /marks/{markId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && resource.data.get('classId', '') != '' && isAssignedTeacher(resource.data.classId))
        || (resource != null && isStudentOwner(resource.data.get('studentId', '')))
      );
      allow create: if request.auth != null && (
        isActiveAdmin()
        || (
          request.resource != null
          && request.resource.data.get('testId', '') != ''
          && request.resource.data.get('classId', '') != ''
          && request.resource.data.get('studentId', '') != ''
          && exists(/databases/$(database)/documents/tests/$(request.resource.data.testId))
          && request.resource.data.get('classId', '') == get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.get('classId', '')
          && isAssignedTeacherForSubject(
               get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.get('classId', ''),
               get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.get('subject', '')
             )
          && (
            !exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
            || !get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.keys().hasAll(['classId'])
            || get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.get('classId', '') == ''
            || get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.get('classId', '') == request.resource.data.classId
          )
        )
      );
      allow update: if request.auth != null && (
        isActiveAdmin()
        || (
          resource != null
          && resource.data.get('testId', '') != ''
          && exists(/databases/$(database)/documents/tests/$(resource.data.testId))
          && isAssignedTeacherForSubject(
               get(/databases/$(database)/documents/tests/$(resource.data.testId)).data.get('classId', ''),
               get(/databases/$(database)/documents/tests/$(resource.data.testId)).data.get('subject', '')
             )
          && request.resource.data.get('testId', '') == resource.data.get('testId', '')
          && (
            !resource.data.keys().hasAll(['classId'])
            || resource.data.get('classId', '') == ''
            || request.resource.data.get('classId', '') == resource.data.classId
          )
          && request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
          && (
            !exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
            || !get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.keys().hasAll(['classId'])
            || get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.get('classId', '') == ''
            || get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.get('classId', '') == request.resource.data.classId
          )
        )
      );
      allow delete: if isActiveAdmin();
    }

    // Marks Audit Collection
    match /marks_audit/{auditId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && resource.data.get('classId', '') != '' && isAssignedTeacher(resource.data.classId))
      );
      allow create: if request.auth != null && (
        isActiveAdmin()
        || (
          request.resource != null
          && request.resource.data.get('testId', '') != ''
          && request.resource.data.get('classId', '') != ''
          && exists(/databases/$(database)/documents/tests/$(request.resource.data.testId))
          && request.resource.data.get('classId', '') == get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.get('classId', '')
          && isAssignedTeacherForSubject(
               get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.get('classId', ''),
               get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.get('subject', '')
             )
          && request.resource.data.get('editedByUid', '') == request.auth.uid
        )
      );
      allow update, delete: if isActiveAdmin();
    }

    // Notices Collection: Active Admin can manage notices
    match /notices/{noticeId} {
      allow read, write: if isActiveAdmin();
    }

    // Complaints Collection: Active Admin can manage complaints; Assigned teachers and student owners can read/create/update
    match /complaints/{complaintId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && resource.data.get('classId', '') != '' && isAssignedTeacher(resource.data.classId))
        || (resource != null && isStudentOwner(resource.data.get('studentId', '')))
      );
      allow create: if request.auth != null && (
        isActiveAdmin()
        || (request.resource != null && request.resource.data.get('classId', '') != '' && isAssignedTeacher(request.resource.data.classId))
        || (request.resource != null && isStudentOwner(request.resource.data.get('studentId', '')))
      );
      allow update: if request.auth != null && (
        isActiveAdmin()
        || (
          resource != null
          && resource.data.get('classId', '') != ''
          && isAssignedTeacher(resource.data.classId)
          && request.resource.data.get('classId', '') == resource.data.classId
          && request.resource.data.get('studentId', '') == resource.data.studentId
        )
        || (
          resource != null
          && isStudentOwner(resource.data.get('studentId', ''))
          && request.resource.data.get('classId', '') == resource.data.classId
          && request.resource.data.get('studentId', '') == resource.data.studentId
        )
      );
      allow delete: if isActiveAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (
        isActiveAdmin()
        || resource.data.get('recipientId', '') == request.auth.uid
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ["admin", "Admin", "ADMIN"] && resource.data.get('recipientRole', '') == "admin")
      );
      allow create: if request.auth != null && (
        isActiveAdmin()
        || request.resource.data.get('recipientId', '') == request.auth.uid
        || (
          request.resource.data.get('recipientRole', '') == "admin"
          && request.resource.data.get('referenceType', '') == 'test'
          && request.resource.data.get('referenceId', '') != ''
          && request.resource.data.get('type', '') in ['test_created', 'test_updated', 'marks_updated', 'test_deleted']
          && isTeacherAuthorizedForTestRef(request.resource.data.referenceId)
        )
      );
      allow update: if request.auth != null && (
        isActiveAdmin()
        || (
          resource.data.get('recipientId', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'updatedAt'])
        )
      );
      allow delete: if request.auth != null && (
        isActiveAdmin()
        || (resource != null && resource.data.get('recipientId', '') == request.auth.uid)
      );
    }

    // Settings Collection: Active Admin can read/write global institute settings
    match /settings/app {
      allow read, write: if isActiveAdmin();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
