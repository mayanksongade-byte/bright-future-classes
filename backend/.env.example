# Server Configuration
PORT=5000
NODE_ENV=production

# CORS (Comma-separated allowed origins, or * for mobile-only APIs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Firebase Admin SDK Configuration
# Option 1 (Recommended on Render): Full JSON string of service account key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 2: Individual variables
FIREBASE_PROJECT_ID=bright-future-classes-ca39a
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option 3: Local file path (Local development only)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
